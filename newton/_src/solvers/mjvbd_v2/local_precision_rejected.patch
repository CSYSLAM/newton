new file mode 100644
index 00000000..b4668182
--- /dev/null
+++ b/newton/tests/test_mjvbd_v2_local_precision.py
@@ -0,0 +1,77 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+
+"""Validate local block inversion independently of scene trajectories."""
+
+import unittest
+
+import numpy as np
+import warp as wp
+
+from newton._src.solvers.mjvbd_v2 import particle_surface_cache
+from newton._src.solvers.mjvbd_v2.vbd_soft import particle_vbd_kernels
+from newton._src.solvers.mjvbd_v2.vbd_soft.solver_vbd import SolverVBD
+from newton.tests.test_mjvbd_v2_surface_relaxation import _cloth
+
+
+class TestMJVBDV2LocalPrecision(unittest.TestCase):
+    def test_ill_conditioned_block_matches_reference(self):
+        for device in ("cpu", "cuda:0") if wp.is_cuda_available() else ("cpu",):
+            with self.subTest(device=device):
+                model = _cloth(device)
+                solver = SolverVBD(model)
+                count = model.particle_count
+                model.tri_materials.zero_()
+                model.edge_bending_properties.zero_()
+                model.particle_mass.fill_(1.0)
+                model.particle_flags.fill_(1)
+                rng = np.random.default_rng(2718)
+                basis, _ = np.linalg.qr(rng.normal(size=(count, 3, 3)))
+                matrices = (basis @ np.diag([1.0, 1000.0, 1.0e7]) @ basis.transpose(0, 2, 1)).astype(np.float32)
+                rhs = rng.normal(size=(count, 3)).astype(np.float32)
+                # Match the actual float32 assembly, then solve that system in float64.
+                assembled = matrices + np.eye(3, dtype=np.float32)[None]
+                reference = np.linalg.solve(assembled.astype(np.float64), rhs.astype(np.float64)[..., None])[..., 0]
+                inputs = [
+                    1.0,
+                    wp.array(np.arange(count), dtype=wp.int32, device=device),
+                    model.particle_q,
+                    model.particle_q,
+                    model.particle_mass,
+                    model.particle_q,
+                    model.particle_flags,
+                    model.tri_indices,
+                    model.tri_poses,
+                    model.tri_materials,
+                    model.tri_areas,
+                    model.edge_indices,
+                    model.edge_rest_angle,
+                    model.edge_rest_length,
+                    model.edge_bending_properties,
+                    solver.particle_adjacency,
+                    wp.array(rhs, dtype=wp.vec3, device=device),
+                    wp.array(matrices, dtype=wp.mat33, device=device),
+                    0,
+                    0,
+                    1.0,
+                    wp.zeros(model.edge_count, dtype=wp.vec2, device=device),
+                    None,
+                ]
+                errors = []
+                for mode in ("single", "double", "adaptive"):
+                    kernel = particle_surface_cache.make_surface_kernel(
+                        particle_vbd_kernels.evaluate_neo_hookean_membrane_force_hessian,
+                        jacobi_update=True,
+                        double_solve=mode == "double",
+                        adaptive_solve=mode == "adaptive",
+                    )
+                    result = wp.zeros(count, dtype=wp.vec3, device=device)
+                    wp.launch(kernel, dim=count * 16, block_dim=16, inputs=inputs, outputs=[result], device=device)
+                    errors.append(float(np.linalg.norm(result.numpy() - reference) / np.linalg.norm(reference)))
+                self.assertGreater(errors[0], 1.0e-3)
+                self.assertLess(errors[1], 1.0e-6)
+                self.assertLess(errors[2], 1.0e-6)
+
+
+if __name__ == "__main__":
+    unittest.main()
