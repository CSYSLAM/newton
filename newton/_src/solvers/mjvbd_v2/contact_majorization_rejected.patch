diff --git a/newton/tests/test_mjvbd_v2_contact_majorization.py b/newton/tests/test_mjvbd_v2_contact_majorization.py
new file mode 100644
index 00000000..25f9cb4f
--- /dev/null
+++ b/newton/tests/test_mjvbd_v2_contact_majorization.py
@@ -0,0 +1,127 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+
+"""Exercise simultaneous contact updates independently of robot trajectories."""
+
+import unittest
+
+import numpy as np
+import warp as wp
+
+from newton._src.solvers.mjvbd_v2.vbd_soft import particle_vbd_kernels as k
+
+
+@wp.kernel
+def _normal_update(
+    anchor: wp.array[wp.vec3],
+    forces: wp.array[wp.vec3],
+    hessians: wp.array[wp.mat33],
+    pos: wp.array[wp.vec3],
+):
+    i = wp.tid()
+    q = pos[i]
+    q[2] += (forces[i][2] + 100.0 * (anchor[i][2] - q[2])) / (100.0 + hessians[i][2, 2])
+    pos[i] = q
+
+
+def contact_fixture(device):
+    def array(values, dtype=wp.int32):
+        return wp.array(values, dtype=dtype, device=device)
+
+    anchor = array([[-1.0, -1.0, 0.0], [1.0, -1.0, 0.0], [0.0, 2.0, 0.0], [0.0, 0.0, 0.008]], wp.vec3)
+    pos = wp.clone(anchor)
+    info = k.TriMeshCollisionInfo()
+    info.edge_colliding_edges_count = array([])
+    info.edge_colliding_edges_buffer_sizes = array([])
+    info.edge_colliding_edges_offsets = array([0])
+    info.edge_colliding_edges = array([])
+    info.vertex_colliding_triangles_count = array([0, 0, 0, 1])
+    info.vertex_colliding_triangles_buffer_sizes = array([0, 0, 0, 1])
+    info.vertex_colliding_triangles_offsets = array([0, 0, 0, 0, 1])
+    info.vertex_colliding_triangles = array([3, 0])
+    inputs = [
+        0.1,
+        0,
+        anchor,
+        pos,
+        array([0, 0, 0, 0]),
+        array([[0, 1, 2]]),
+        wp.empty((0, 4), dtype=wp.int32, device=device),
+        array([info], k.TriMeshCollisionInfo),
+        0.01,
+        1000.0,
+        0.0,
+        0.0,
+        wp.empty(0, dtype=wp.vec3, device=device),
+        array([]),
+        False,
+        0.01,
+        1.0e-6,
+        array([1]),
+    ]
+    # Keep owners of the array fields stored as device struct pointers.
+    return anchor, pos, inputs, info
+
+
+class TestMJVBDV2ContactMajorization(unittest.TestCase):
+    def test_contact_forces_and_single_vertex_colors_are_unchanged(self):
+        """Bound EE/VT Hessians without changing forces or uncoupled colors."""
+        for device in ("cpu", "cuda:0") if wp.is_cuda_available() else ("cpu",):
+            for edge_contact in (False, True):
+                anchor, pos, inputs, owner = contact_fixture(device)
+                if edge_contact:
+                    q = np.array([[-1, 0, 0], [1, 0, 0], [0, -1, 0.008], [0, 1, 0.008]], dtype=np.float32)
+                    anchor.assign(q)
+                    pos.assign(q)
+                    owner.edge_colliding_edges_count = wp.ones(2, dtype=wp.int32, device=device)
+                    owner.edge_colliding_edges_buffer_sizes = wp.ones(2, dtype=wp.int32, device=device)
+                    owner.edge_colliding_edges_offsets = wp.array([0, 1, 2], dtype=wp.int32, device=device)
+                    owner.edge_colliding_edges = wp.array([0, 1, 1, 0], dtype=wp.int32, device=device)
+                    owner.vertex_colliding_triangles_count.zero_()
+                    owner.vertex_colliding_triangles_buffer_sizes.zero_()
+                    inputs[6] = wp.array([[0, 0, 0, 1], [0, 0, 2, 3]], dtype=wp.int32, device=device)
+                    inputs[7] = wp.array([owner], dtype=k.TriMeshCollisionInfo, device=device)
+                for colors, multiplicity in (([0, 0, 0, 0], 4), ([0, 1, 0, 1], 2), ([0, 1, 2, 3], 1)):
+                    with self.subTest(device=device, edge_contact=edge_contact, colors=colors):
+                        inputs[4].assign(np.array(colors, dtype=np.int32))
+                        results = []
+                        for enabled in (False, True):
+                            force = wp.zeros(4, dtype=wp.vec3, device=device)
+                            hessian = wp.zeros(4, dtype=wp.mat33, device=device)
+                            wp.launch(
+                                k.make_self_contact_kernel(enabled),
+                                dim=16,
+                                inputs=inputs,
+                                outputs=[force, hessian],
+                                device=device,
+                            )
+                            results.append((force.numpy(), hessian.numpy()))
+                        self.assertGreater(float(np.linalg.norm(results[0][0])), 0.0)
+                        np.testing.assert_allclose(results[1][0], results[0][0], rtol=1e-6, atol=1e-7)
+                        np.testing.assert_allclose(results[1][1], multiplicity * results[0][1], rtol=1e-6, atol=1e-7)
+
+    def test_coupled_contact_converges_without_changing_equilibrium(self):
+        """Eliminate the legacy two-cycle for four simultaneous contact vertices."""
+        device = "cpu"
+        anchor, pos, inputs, owner = contact_fixture(device)
+        forces = wp.zeros(4, dtype=wp.vec3, device=device)
+        hessians = wp.zeros(4, dtype=wp.mat33, device=device)
+        initial = anchor.numpy()
+        b = np.array([-1.0 / 3, -1.0 / 3, -1.0 / 3, 1.0])
+        exact = initial[:, 2] + 1000.0 * (0.01 - b @ initial[:, 2]) / (100.0 + 1000.0 * (b @ b)) * b
+        errors = []
+        for kernel in (k.accumulate_self_contact_force_and_hessian, k.make_self_contact_kernel(True)):
+            pos.assign(initial)
+            for _ in range(256):
+                forces.zero_()
+                hessians.zero_()
+                wp.launch(kernel, dim=16, inputs=inputs, outputs=[forces, hessians], device=device)
+                wp.launch(_normal_update, dim=4, inputs=[anchor, forces, hessians], outputs=[pos], device=device)
+            errors.append(float(np.linalg.norm(pos.numpy()[:, 2] - exact)))
+        self.assertGreater(errors[0], 1.0e-3)
+        self.assertLess(errors[1], 1.0e-7)
+        self.assertEqual(owner.vertex_colliding_triangles.size, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
